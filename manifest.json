{
  "name": "Connect Z",
  "description": "Connect Z is a tool that helps you to utilize the power of linkedin.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://connectz.site/*",
    "https://www.linkedin.com/*",
    "http://16.171.166.83/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png",
    "default_title": "Connect Z - Check Login"
  }
}