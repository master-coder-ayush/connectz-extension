{
  "name": "Connect Z",
  "description": "Connect Z is a tool that helps you to utilize the power of linkedin.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://connectz.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png",
    "default_title": "Connect Z - Check Login"
  }
}