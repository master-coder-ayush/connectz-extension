{
  "name": "Connect Z",
  "description": "Connect Z is a tool that helps you to utilize the power of linkedin.",
  "version": "1.1.1",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://connectz.one/*",
    "https://www.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    },
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png",
    "default_title": "Connect Z - Check Login"
  }
}